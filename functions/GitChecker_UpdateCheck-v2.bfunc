# shellcheck disable=SC1083 

function DisplayUpdateStatus() { # For use within the CheckUpdate_New function
# Fetch upstream data quietly
		
	# Multi-Repo Scripting Tip
		# Since this script uses return 1 on a failed git fetch, if it encounters a repository with network issues, bad credentials, or an unconfigured upstream tracking branch, the entire script (or function) will instantly terminate.
		# If you are looping through multiple directories and want to skip broken ones instead of crashing the whole process, swap return 1 out for a continue:
			git fetch &>/dev/null || return 1
			# git fetch &>/dev/null || { echo -e " ${white}${d%/}: ${yellow}[Error]${reset} "; continue; } # This causes SC2104.
	
	# Define vars for LOCAL, REMOTE, and BASE
	LOCAL=$(git rev-parse HEAD)
	REMOTE=$(git rev-parse @{u})
	BASE=$(git merge-base HEAD @{u})

	if [ "$LOCAL" = "$REMOTE" ]; then
    	echo "Up-to-date"
	elif [ "$LOCAL" = "$BASE" ]; then
    	echo "Need to pull (You are behind)"
	elif [ "$REMOTE" = "$BASE" ]; then
    	echo "Need to push (You are ahead)"
	else
    	echo "Diverged (You need to merge or rebase)"
	fi
}




##########################################################################################################################################


function CheckUpdate_New() {
    # Check Repos For Updates & display Yes or No
    for d in */; do
        if [ -d "$d/.git" ]; then
            # Use a subshell () instead of 'cd -' to safely isolate directory changes
            (
                cd "$d" || exit 1
                
                # Fetch upstream data quietly
                git fetch &>/dev/null || exit 1
                
                # Compare local HEAD with the upstream tracking branch
                if [ "$(git rev-parse HEAD)" = "$(git rev-parse @{u})" ]; then
                    echo -e " ${white}${d%/}: ${red}[No]${reset} "
                else
                    echo -e " ${white}${d%/}: ${green}[Yes]${reset} "
                fi
            )
        fi
    done
}


function CheckUpdate_New2() {

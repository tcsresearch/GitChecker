#!/usr/bin/env bash

# This script checks subdirectories to see if they are Git repos.
# Last Updated: Wed July 29, 2026

# ShellCheck: Disable color warnings.
# shellcheck disable=SC2154


# TODO: Add CASE statment for --show-git-only and --show-nongit-only and --show-all
# 	    Add 'git pull' feature to update all repos via --update-all
#       Add feature to show update available with listing.

#################################################################################################
# Version #											#
#################################################################################################

   VERSION="26.07"
   LAST_UPDATED="Wed Jul 29, 2026"


#################################################################################################
# Colors & Functions #										#
#################################################################################################

# Colors for Cecho-like output
   COLORS_DIR="$(pwd)"
   COLORS_FILE="Colors.conf"

# Define Config Folder / File
   CONFIG_DIR="$(pwd)"
   CONFIG_FILE="GitChecker.bfunc"


# Define Functions Library Folder / File
   FUNCTIONS_DIR="$(pwd)"
   FUNCTIONS_FILE="GitChecker.bfunc"


#################################################################################################
# Configuration #										#
#################################################################################################

   # Display Settings
   SHOW_ALL="false"
   SHOW_GIT_ONLY="false"
   SHOW_NONGIT_ONLY="false"

   # CheckUpdate Settings
   CHECKUPDATE="false"
   CHECKUPDATE_ALL="false"

   # Update Settings
   UPDATE="false"
   UPDATE_ALL="false"
